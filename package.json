{
  "name": "micrometricpro",
  "version": "0.1.0",
  "private": true,
  "description": "Calibrated microscope measurement and stomata counting for Android.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && node scripts/check-source.mjs",
    "test:unit": "node --test tests/unit/*.spec.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "node scripts/build-android.mjs debug",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
